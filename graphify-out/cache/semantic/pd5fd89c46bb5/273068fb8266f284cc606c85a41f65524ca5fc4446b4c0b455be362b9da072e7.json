{"nodes": [{"id": "current_status_ai_service_client", "label": "AIServiceClient (Java WebClient integration)", "file_type": "document", "source_file": "current_status.md", "source_location": "lines 103-112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implemented as an interface plus a WebClient implementation configured in AIServiceConfig, pointing at ai-service.base-url with a 300000ms timeout because AI workflows are long-running; spring-boot-starter-webflux was added to pom.xml for this."}, {"id": "current_status_candidate_service", "label": "CandidateServiceImplementation (upload orchestration)", "file_type": "document", "source_file": "current_status.md", "source_location": "lines 107-110, 180-196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orchestrates upload -> persist Candidate+Resume to PostgreSQL -> store the PDF -> emit IngestResumeEvent to the AI service, so the HTTP upload returns immediately and the heavy work happens in Inngest."}, {"id": "current_status_file_storage_service", "label": "FileStorageService (local filesystem)", "file_type": "document", "source_file": "current_status.md", "source_location": "lines 111-112, 341-343", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local filesystem implementation behind an interface at app.file.storage.path=./uploads; the interface exists so S3/MinIO can replace it for production, which is still an open TODO."}, {"id": "current_status_ai_callback_controller", "label": "AICallbackController (/api/ai/* callbacks)", "file_type": "document", "source_file": "current_status.md", "source_location": "lines 125-126, 157-164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Receives match-scores, rag-summaries, rankings/{jobId} and candidate-profile pushed back by the Python service, which is what lets the AI service stay stateless. Flagged as an open risk: these callback routes are not yet secured by API key or JWT."}, {"id": "current_status_ai_dto_event_model", "label": "AI Event & Result DTO Model (dto/ai)", "file_type": "document", "source_file": "current_status.md", "source_location": "lines 85-101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IngestResumeEvent, ScoreJobEvent, RAGSummaryEvent and RankCandidatesEvent on the outbound side and JobDescription, JobRequirement, MatchScore, RAGSummary, EvidenceChunk, RankedCandidate and RankingResult on the inbound side form the typed contract shared with the Python Pydantic schemas."}, {"id": "current_status_resume_upload_flow", "label": "Resume Upload Flow", "file_type": "concept", "source_file": "current_status.md", "source_location": "lines 178-196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multipart upload at /api/recruiter/candidates/upload persists metadata in PostgreSQL and the PDF on disk, then the AI service extracts, chunks with section inference, extracts a profile with an LLM, embeds and stores in Qdrant."}, {"id": "current_status_candidate_scoring_flow", "label": "Candidate Scoring Flow", "file_type": "concept", "source_file": "current_status.md", "source_location": "lines 198-214", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java fetches the Job, builds a JobDescription DTO and emits ScoreJobEvent; Python embeds the JD, pulls candidate chunks from Qdrant, scores skills/experience/education/semantic and POSTs the result back to /api/ai/match-scores."}, {"id": "current_status_rag_summary_flow", "label": "RAG Summary Flow", "file_type": "concept", "source_file": "current_status.md", "source_location": "lines 216-230", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java emits RAGSummaryEvent only; all retrieval, reranking and generation happen in Python and the grounded summary is POSTed back to /api/ai/rag-summaries."}, {"id": "current_status_candidate_ranking_flow", "label": "Candidate Ranking Flow", "file_type": "concept", "source_file": "current_status.md", "source_location": "lines 232-246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranking consumes previously stored match scores rather than rescoring, sorts by overall score, attaches RAG summaries for top candidates and POSTs to /api/ai/rankings/{jobId}."}, {"id": "current_status_known_issues", "label": "Integration Known Issues & TODOs", "file_type": "rationale", "source_file": "current_status.md", "source_location": "lines 331-345", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Java currently relays Inngest events through the AI service because there is no Java Inngest SDK; file storage is local-only; the extracted candidate profile is not yet synced back to the Candidate entity; workflow triggers are fire-and-forget with no status endpoint for UI feedback; /api/ai/* callbacks are unauthenticated; retries and a dead letter queue are missing; bulk upload is sequential."}, {"id": "current_status_inngest_relay_decision", "label": "Inngest Event Relay via AI Service", "file_type": "rationale", "source_file": "current_status.md", "source_location": "line 333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Java backend sends events over REST to the AI service, which then forwards them to Inngest, because no Java Inngest SDK is available; the documented alternative is calling the Inngest REST API directly from Java."}], "edges": [{"source": "implementation_plan_pythonaiclient", "target": "current_status_ai_service_client", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "current_status.md", "source_location": null, "weight": 1.0}, {"source": "readme_ai_ser