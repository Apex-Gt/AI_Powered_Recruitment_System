# Backend secrets when running with `mvnw spring-boot:run` from the backend/ folder. Copy to `.env` (git-ignored).
# application.properties imports this file, and any value here overrides the one in the properties file.
# Under Docker Compose the same settings come from the root .env instead.

spring.datasource.url=jdbc:postgresql://localhost:5433/ai_resume_db
spring.datasource.username=postgres
spring.datasource.password=

# At least 32 random characters. The value currently in application.properties is committed to git: replace it.
jwt.secret=

# Email (assessment invitations, recruiter credentials). A Gmail app password, not your account password.
spring.mail.username=
spring.mail.password=

# City autocomplete.
geoapify.api-key=

# Shared secret for the AI service's pipeline endpoints. Must equal PIPELINE_API_KEY in ai-service/.env.
pipeline.ai.api-key=

# Pipeline tuning (defaults shown in application.properties).
# pipeline.worker.concurrency=2
# pipeline.retry.max-attempts=8
