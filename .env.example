# Copy to .env and fill in. `.env` is git-ignored: never commit it, and never put real values in this file.
# Generate secrets with:   openssl rand -hex 32     (or any password manager)

# ---- REQUIRED ---------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=
# Signs login tokens. At least 32 random characters.
JWT_SECRET=
# Shared secret between the backend and the AI service's pipeline endpoints.
PIPELINE_API_KEY=

# ---- Database ---------------------------------------------------------------------------------------------------
POSTGRES_DB=ai_resume_db
POSTGRES_USER=postgres

# ---- Models (open-weight, run locally by Ollama; no API key, no per-call cost) -----------------------------------------
# Chat model for profile extraction and summaries. qwen3:4b is the starting point; benchmark qwen3:8b only if you have the
# VRAM/RAM (see docs/PIPELINE.md). Any Ollama tag works.
LLM_MODEL=qwen3:4b
# Embedding model. bge-m3 is 1024-dimensional, matching the Qdrant collection. Changing to a model with a different size
# needs a new collection (the AI service refuses to start against a mismatched one rather than corrupt it).
EMBEDDING_MODEL=bge-m3
# Keep models resident between resumes.
OLLAMA_KEEP_ALIVE=30m
# Move the multi-GB model store to another drive: set a host path (e.g. D:/ollama or /mnt/data/ollama).
# OLLAMA_MODELS_DIR=

# ---- Throughput (raise only after benchmarking RAM, VRAM and queue latency) ------------------------------------------
# Resumes processed at once by the backend worker. The LLM itself serves one request at a time (LLM_CONCURRENCY).
PIPELINE_WORKER_CONCURRENCY=2
LLM_CONCURRENCY=1
# none keeps vector order (no extra model); local needs the torch build of the AI service.
RERANKER_PROVIDER=none
PIPELINE_OCR_ENABLED=true

# ---- Web ---------------------------------------------------------------------------------------------------------
HTTP_PORT=8080
# The URL users type; used in emailed links (assessment invitations, credentials).
PUBLIC_URL=http://localhost:8080
# true when served over HTTPS (production).
COOKIE_SECURE=false

# ---- Optional ---------------------------------------------------------------------------------------------------
# Email for assessment invitations and recruiter credentials. Leave empty to run without email.
MAIL_USERNAME=
MAIL_PASSWORD=
# City autocomplete on the job form.
GEOAPIFY_API_KEY=
# Legacy AI-service -> backend callback key (used by the older Inngest workflows only).
SERVICE_API_KEY=
LOG_LEVEL=INFO
