# AI Service Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model Configuration
MODEL_FOUNDATION_MODEL=Qwen3-Embedding-8B
MODEL_EMBEDDING_MODEL=BGE-M3
MODEL_EMBEDDING_DIMENSIONS=1024
MODEL_LLM_MODEL=gpt-4o-mini
MODEL_LLM_TEMPERATURE=0.1
MODEL_LLM_MAX_TOKENS=4096

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=resume_chunks
QDRANT_DISTANCE_METRIC=cosine
QDRANT_BATCH_SIZE=100
QDRANT_TIMEOUT=30.0

# Inngest Configuration
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_BASE_URL=http://localhost:8288
INNGEST_DEV_MODE=true

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

# Embedding Service Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60.0

# Reranker Service Configuration
RERANKER_PROVIDER=local
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20
RERANKER_MAX_RETRIES=3
RERANKER_TIMEOUT=60.0

# Scoring Configuration
SCORING_SKILL_WEIGHT=0.40
SCORING_EXPERIENCE_WEIGHT=0.20
SCORING_EDUCATION_WEIGHT=0.10
SCORING_SEMANTIC_WEIGHT=0.30
SCORING_MIN_SKILL_MATCH_THRESHOLD=0.3
SCORING_PROMPT_VERSION=1.0
SCORING_SCORING_VERSION=1.0

# Chunking Configuration
CHUNKING_CHUNK_SIZE=1000
CHUNKING_CHUNK_OVERLAP=200
CHUNKING_MIN_CHUNK_SIZE=100

# Spring Boot Integration
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_API_KEY=
SPRING_BOOT_TIMEOUT=30.0