# AI service settings for running it directly on the host (not in Docker). Copy to `.env`; `.env` is git-ignored.
# Under Docker Compose these come from the root .env.example instead.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# ---- Chat model: local Ollama, OpenAI-compatible endpoint. No key, no per-call cost. ----------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=
# Simultaneous chat requests from this process. Match OLLAMA_NUM_PARALLEL.
LLM_CONCURRENCY=1
LLM_TIMEOUT=170
# Small GPU (6 GB): use a model that fits entirely in VRAM (qwen3:4b ~2.6 GB; a 7B like mistral spills to CPU and is ~3x slower),
# and start Ollama with these so the model stays loaded, is not truncated, and embeddings never evict it:
#   OLLAMA_CONTEXT_LENGTH=8192  OLLAMA_KEEP_ALIVE=30m  OLLAMA_MAX_LOADED_MODELS=1  and EMBEDDING_OLLAMA_NUM_GPU=0 below.
# PIPELINE_PROFILE_TEXT_CHARS / PIPELINE_PROFILE_MAX_TOKENS bound the prompt and the JSON the model writes (the slow part).
# Faster and usually more accurate: a hosted OpenAI-compatible endpoint instead of Ollama. Resume text is sent to that
# provider, and free tiers are rate limited (a 429 is retried by the queue). Examples, replacing the three lines above:
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=<a model id from openrouter.ai/models, e.g. one ending in :free>
#   NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=<a model id from build.nvidia.com>
#   plus LLM_API_KEY=<your key>  and  LLM_CONCURRENCY=2
# Keep LLM_TIMEOUT below the backend's pipeline.ai.profile-timeout (3 minutes), because the SDK retries a timeout once.

# ---- Vector store -----------------------------------------------------------------------------------------------
# Embedded Qdrant inside this process: no Qdrant server or Docker needed, and data persists in this folder.
# Single process only (keep API_WORKERS=1). For the Docker stack leave it unset: compose uses the qdrant service.
QDRANT_PATH=./data/qdrant

# ---- Embeddings: Ollama's bge-m3 is 1024-d, the same size as the Qdrant collection. No torch needed. -----------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL_NAME=bge-m3
EMBEDDING_DIMENSIONS=1024
MODEL_EMBEDDING_DIMENSIONS=1024
# To run BGE-M3 in-process instead (about 4 GB with torch): pip install -e ".[local-embeddings]" and set
# EMBEDDING_PROVIDER=local, EMBEDDING_MODEL_NAME=BAAI/bge-m3, RERANKER_PROVIDER=local.
RERANKER_PROVIDER=none

# ---- Vector store ---------------------------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=resume_chunks

# ---- Pipeline -------------------------------------------------------------------------------------------------------
# Shared secret the backend sends as X-API-Key. Empty disables the check (local development only).
PIPELINE_API_KEY=
PIPELINE_MAX_FILE_MB=10
PIPELINE_OCR_ENABLED=true
PIPELINE_EMBED_CONCURRENCY=1

# ---- Scoring (defaults are the specified weights; they sum to 1.0) ---------------------------------------------------
SCORING_SKILL_WEIGHT=0.40
SCORING_EXPERIENCE_WEIGHT=0.20
SCORING_EDUCATION_WEIGHT=0.10
SCORING_SEMANTIC_WEIGHT=0.30
SCORING_SCORING_VERSION=2.0

# ---- Legacy Inngest workflows (the batch pipeline does not use them) --------------------------------------------------
INNGEST_ENABLED=false
INNGEST_DEV_MODE=true
INNGEST_BASE_URL=http://localhost:8288
SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_API_KEY=
